# Server-side rewrite target (Vercel / local Next). No trailing slash.
API_PROXY_TARGET=http://127.0.0.1:8000

# Leave empty to use same-origin /api via rewrite (recommended).
# Or set full backend origin and configure CORS_ORIGINS on the API.
NEXT_PUBLIC_API_BASE=

# Optional: must match backend ACCESS_TOKEN when that is set.
NEXT_PUBLIC_AXIOM_ACCESS_TOKEN=
