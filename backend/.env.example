OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
AI_PROVIDER=ollama
# CPU machines: keep these capped so Tutor replies finish sooner
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT_CHAT=384
OLLAMA_NUM_PREDICT_SOLVE=640
OLLAMA_TEMPERATURE=0.4
OLLAMA_KEEP_ALIVE=30m

# Faster path: set key and switch provider (backend only; never put keys in frontend)
# AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini (generateContent) — https://aistudio.google.com/apikey
# AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_OUTPUT_TOKENS=512

# Vision
VISION_PROVIDER=ollama
OLLAMA_VISION_MODEL=moondream:latest
MAX_IMAGE_BYTES=5242880

# Upload / ingestion
MAX_UPLOAD_SIZE=20971520
MAX_PDF_PAGES=200
CHUNK_SIZE=900
CHUNK_OVERLAP=120

# Agent / tools
MAX_AGENT_STEPS=6
MODEL_TIMEOUT_SECONDS=120
VISION_TIMEOUT_SECONDS=180
TOOL_TIMEOUT_SECONDS=5
PYTHON_TIMEOUT_SECONDS=3
PYTHON_OUTPUT_LIMIT=20000

# Vision confidence
VISION_HIGH_CONFIDENCE_THRESHOLD=0.75
VISION_LOW_CONFIDENCE_THRESHOLD=0.35

# Lightweight local embeddings (does not download a model)
EMBEDDING_PROVIDER=local_hash
EMBEDDING_DIMENSIONS=256
